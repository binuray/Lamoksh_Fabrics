NODE_ENV=development
PORT=5000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lamkosh?schema=public

JWT_ACCESS_SECRET=super_secret_access_key_change_in_production_123456789!@#$
JWT_REFRESH_SECRET=super_secret_refresh_key_change_in_production_987654321!@#$

ACCESS_TOKEN_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d

OTP_EXPIRES_IN_MINUTES=10
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=60

SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=ethereal_user
SMTP_PASSWORD=ethereal_pass
SMTP_FROM="Lamkosh Security <no-reply@lamkosh.com>"

CLIENT_URL=http://localhost:3000

STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=uploads

# AWS S3 Storage (Mandatory when NODE_ENV=production)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=lamkosh-products-bucket

